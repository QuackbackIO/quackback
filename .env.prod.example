# ============================================================================
# Quackback production environment — for docker-compose.prod.yml
# ============================================================================
# Copy to .env (in the repo root, next to docker-compose.prod.yml), fill in
# EVERY value below, then:
#   docker compose -f docker-compose.prod.yml up -d
#
# Rules (Docker reads these literally):
#   - no quotes around values
#   - no inline "# comments" on a value line
#
# You do NOT set DATABASE_URL / S3_ENDPOINT / S3 keys here — the
# prod compose builds those from the secrets below and wires them to the
# internal services automatically.

# --- Application ---------------------------------------------------------
# Public URL of your instance (auth, emails and OAuth callbacks depend on it).
BASE_URL=https://feedback.example.com

# Session signing + encryption key. MUST be >= 32 chars; the stack refuses to
# start while it is empty. Generate with: openssl rand -base64 32
SECRET_KEY=

# Reverse proxies in front of the app. Controls where the client IP used for
# rate limiting is read from X-Forwarded-For.
#   0 = clients connect directly (default)
#   1 = behind one reverse proxy (nginx, Caddy, Traefik, Cloudflare tunnel)
#   2 = behind a CDN plus a reverse proxy
# Leave at 0 if the app port is reachable directly: a higher value lets any
# client spoof its IP. Left at 0 behind a proxy, all clients share one bucket.
TRUSTED_PROXY_HOPS=0

# Alternative to counting hops: a single header your proxy sets to the client
# IP, e.g. X-Real-IP (nginx: proxy_set_header X-Real-IP $remote_addr;) or
# CF-Connecting-IP (Cloudflare). Use it when the number of proxies in front of
# the app is unknown or varies. It wins over TRUSTED_PROXY_HOPS, which still
# applies when a request lacks the header. Only set it if your proxy always
# sets or overwrites the header and the app port is not reachable directly;
# otherwise clients can spoof their IP.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Published image tag to run. Pin to a release (e.g. 0.10.6) in production.
QUACKBACK_TAG=latest

# Host port to publish the app on (the container always listens on 3000).
APP_PORT=3000

# --- PostgreSQL (internal `postgres` service) ----------------------------
POSTGRES_USER=quackback
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=quackback

# --- Object storage (internal `minio` service) ---------------------------
# These double as the S3 access key / secret the app uses.
MINIO_ROOT_USER=quackback
# Generate with: openssl rand -base64 24
MINIO_ROOT_PASSWORD=
S3_BUCKET=quackback
S3_REGION=us-east-1

# Bundled object storage: PGSTY Silo and its client, pinned by digest in Compose.
# Leave unset to use the defaults. Full image references also support mirrors.
# SILO_IMAGE=pgsty/silo:RELEASE.2026-09-16T00-00-00Z@sha256:635197cb9f36d01bee221d34d1c7d7960f6a95c48b0b6c01d99cd13bdae51a46
# SILO_CLIENT_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z@sha256:cfc83108c3abb371f8fb84d99c1fdc88f8c237e022409b0081fb7c0a3be634dd
# Legacy MINIO_IMAGE_TAG / MC_IMAGE_TAG settings are ignored. Remove them;
# use the full Silo references above if you need to override the defaults.
# Before migrating an existing volume, follow deploy/self-hosted/README.md.

# --- Email (required for invites, magic links, notifications) ------------
# Configure exactly ONE sending provider: SMTP, Amazon SES or Resend. With
# more than one set the app refuses to start and names the variables in
# conflict. Leave all blank to log emails to the console.
#
# SMTP (works with any provider).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=Quackback <noreply@example.com>
# Or the Amazon SES API. All three are required: the region is the one the
# sending identity is verified in, and there is no default because a verified
# identity is regional.
# EMAIL_SES_ACCESS_KEY_ID=
# EMAIL_SES_SECRET_ACCESS_KEY=
# EMAIL_SES_REGION=us-east-1
# Most sends per second from each process (default 10). The SES quota is per
# account: with N processes sending, set roughly the account quota / N.
# EMAIL_SES_MAX_SEND_RATE=10
# Or the Resend API (RESEND_API_KEY also works).
# EMAIL_RESEND_API_KEY=
# A Resend key kept only to receive inbound mail through Resend while SMTP or
# SES sends needs this, or the app counts it as a second sending provider:
# EMAIL_INBOUND_PROVIDER=resend

# --- AI (optional) -------------------------------------------------------
# Enables summaries, duplicate detection, feedback extraction, etc.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
