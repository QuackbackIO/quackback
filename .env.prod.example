# ============================================================================
# Quackback production environment — for docker-compose.prod.yml
# ============================================================================
# Copy to .env (in the repo root, next to docker-compose.prod.yml), fill in
# EVERY value below, then:
#   docker compose -f docker-compose.prod.yml up -d
#
# Rules (Docker reads these literally):
#   - no quotes around values
#   - no inline "# comments" on a value line
#
# You do NOT set DATABASE_URL / S3_ENDPOINT / S3 keys here — the
# prod compose builds those from the secrets below and wires them to the
# internal services automatically.

# --- Application ---------------------------------------------------------
# Public URL of your instance (auth, emails and OAuth callbacks depend on it).
BASE_URL=https://feedback.example.com

# Session signing + encryption key. MUST be >= 32 chars.
# Generate with: openssl rand -base64 32
# SECRET_KEY=replace-with-generated-value

# Published image tag to run. Pin to a release (e.g. 0.10.6) in production.
QUACKBACK_TAG=latest

# Host port to publish the app on (the container always listens on 3000).
APP_PORT=3000

# --- PostgreSQL (internal `postgres` service) ----------------------------
POSTGRES_USER=quackback
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=quackback

# --- Object storage (internal `minio` service) ---------------------------
# These double as the S3 access key / secret the app uses.
MINIO_ROOT_USER=quackback
# Generate with: openssl rand -base64 24
MINIO_ROOT_PASSWORD=
S3_BUCKET=quackback
S3_REGION=us-east-1

# Bundled object storage: PGSTY Silo and its client, pinned by digest in Compose.
# Leave unset to use the defaults. Full image references also support mirrors.
# SILO_IMAGE=pgsty/silo:RELEASE.2026-09-16T00-00-00Z@sha256:635197cb9f36d01bee221d34d1c7d7960f6a95c48b0b6c01d99cd13bdae51a46
# SILO_CLIENT_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z@sha256:cfc83108c3abb371f8fb84d99c1fdc88f8c237e022409b0081fb7c0a3be634dd
# Legacy MINIO_IMAGE_TAG / MC_IMAGE_TAG settings are ignored. Remove them;
# use the full Silo references above if you need to override the defaults.
# Before migrating an existing volume, follow deploy/self-hosted/README.md.

# --- Email (required for invites, magic links, notifications) ------------
# SMTP (works with any provider). Leave blank to log emails to the console.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=Quackback <noreply@example.com>
# Or use the Amazon SES API instead of SMTP. All three are required: the
# region is the one the sending identity is verified in, and there is no
# default because a verified identity is regional.
# EMAIL_SES_ACCESS_KEY_ID=
# EMAIL_SES_SECRET_ACCESS_KEY=
# EMAIL_SES_REGION=us-east-1

# --- AI (optional) -------------------------------------------------------
# Enables summaries, duplicate detection, feedback extraction, etc.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
