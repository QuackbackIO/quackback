# The support e2e suite's own environment (playwright.support.config.ts).
#
# CI-only values for local stand-ins: no secret here reaches anything real.
# The app server is started with exactly this environment plus the derived
# values in env.ts, never with the repo-root .env, so a local run cannot send
# real mail or spend real AI credit. Override any key for a local run with
# E2E_SUPPORT_<KEY> (for example E2E_SUPPORT_PORT=3417); see
# e2e/tests/support/README.md.

NODE_ENV=production
E2E_HARNESS=1
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/quackback_test
SECRET_KEY=support-e2e-secret-key-for-ci-only-at-least-32-chars
# Settings changed with raw SQL are seen at once by the production build.
QUACKBACK_SETTINGS_CACHE_MS=0
DISABLE_TELEMETRY=1
DISABLE_AUTOMATIC_BRANDING=1
LOG_LEVEL=info

# Outbound mail goes to Mailpit.
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_FROM=Acme Support <support@acme.test>
MAILPIT_API_URL=http://localhost:8025

# Inbound mail: the signer helper posts signed JSON with this secret.
EMAIL_INBOUND_DOMAIN=inbound.test
EMAIL_INBOUND_SIGNING_SECRET=whsec_c3VwcG9ydC1lMmUtaW5ib3VuZC1zaWduaW5nLWtleS1jaS1vbmx5

# AI goes to the fake OpenAI-compatible server (stand-ins/fake-ai.ts).
OPENAI_API_KEY=fake-ai-key-ci-only
AI_CHAT_MODEL=fake-chat
AI_EMBEDDING_MODEL=fake-embedding
E2E_FAKE_AI_PORT=4010

# Object storage: the S3-compatible container (see the README).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=quackback-e2e
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PROXY=true

# Webhooks: the https sink (stand-ins/webhook-sink.ts) and its control port.
E2E_WEBHOOK_SINK_PORT=4011
E2E_WEBHOOK_SINK_CONTROL_PORT=4012
