exports[`the changelog list without a choice > is exactly today’s 1`] = `"<div><div class="mb-8 flex flex-wrap items-center gap-1.5"><button type="button" class="rounded-full px-3 py-1 text-xs font-medium transition-colors bg-foreground text-background">All</button><button type="button" class="rounded-full px-3 py-1 text-xs font-medium transition-colors hover:opacity-80" style="background-color: #2563eb1a; color: #2563eb;">Improved</button></div><div class="divide-y divide-border/40"><div class="py-10 first:pt-0 animate-in fade-in duration-200 fill-mode-backwards" style="animation-delay: 0ms;"><article class="flex gap-8 lg:gap-16"><div class="hidden md:block w-40 shrink-0 pt-1"><time datetime="2026-10-01T12:00:00.000Z" class="text-sm text-muted-foreground">October 1, 2026</time></div><div class="flex-1 min-w-0"><time datetime="2026-10-01T12:00:00.000Z" class="md:hidden text-sm text-muted-foreground mb-4 block">October 1, 2026</time><div class="mb-2 flex flex-wrap gap-1.5"><span data-qb-part="tag" class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium qb-tag-tint text-foreground" style="--qb-tag: #2563eb;">Improved</span></div><a href="/changelog/$entryId" class="group inline-flex items-center gap-2"><h2 data-qb-part="section-heading" class="text-2xl font-bold group-hover:text-primary transition-colors">Faster search</h2><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 text-muted-foreground/40 opacity-0 group-hover:opacity-100 transition-opacity shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"></path></svg></a><div class="mt-4"><p class="whitespace-pre-wrap">Search is faster now. It finds posts by their comments too.</p></div><div class="mt-6 grid gap-2"><a href="/b/$slug/posts/$postId" class="flex items-center gap-3 px-3 py-2.5 rounded-lg border border-border/50 hover:border-border hover:bg-muted/30 transition-all group/post"><div class="flex items-center gap-0.5 text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5"></path></svg><span class="text-xs font-medium">12</span></div><span class="flex-1 min-w-0 text-sm font-medium truncate group-hover/post:text-primary transition-colors">Search comments</span><span data-qb-part="status-badge" style="--qb-status: #16a34a;" class="inline-flex items-center gap-1.5 text-xs font-medium text-foreground shrink-0"><span data-qb-status-dot="" class="size-1.5 shrink-0 rounded-full bg-[var(--qb-status)]" aria-hidden="true"></span>Shipped</span></a></div></div></article></div><div class="py-10 first:pt-0 animate-in fade-in duration-200 fill-mode-backwards" style="animation-delay: 50ms;"><article class="flex gap-8 lg:gap-16"><div class="hidden md:block w-40 shrink-0 pt-1"><time datetime="2026-09-20T12:00:00.000Z" class="text-sm text-muted-foreground">September 20, 2026</time></div><div class="flex-1 min-w-0"><time datetime="2026-09-20T12:00:00.000Z" class="md:hidden text-sm text-muted-foreground mb-4 block">September 20, 2026</time><a href="/changelog/$entryId" class="group inline-flex items-center gap-2"><h2 data-qb-part="section-heading" class="text-2xl font-bold group-hover:text-primary transition-colors">Dark mode</h2><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 text-muted-foreground/40 opacity-0 group-hover:opacity-100 transition-opacity shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"></path></svg></a><div class="mt-4"><p class="whitespace-pre-wrap">The portal follows your device.</p></div></div></article></div></div></div>"`;
