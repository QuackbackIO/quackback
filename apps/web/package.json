  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env vite dev",
    "build": "QUACKBACK_BUILD=1 vite build",
    "preview": "vite preview",
    "start": "bun --env-file=../../.env .output/server/index.mjs",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "generate:platform-schema": "bun scripts/generate-platform-schema.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:support": "playwright test -c playwright.support.config.ts",
    "test:e2e:product": "playwright test -c playwright.product.config.ts",
    "check:widget-bundle": "bun scripts/check-widget-bundle.ts",
    "check:client-imports": "bun scripts/check-client-imports.ts",
    "check:server-fn-manifest": "bun scripts/check-server-fn-manifest.ts",
    "perf:setup": "bun perf/setup-db.ts",
    "perf": "bun perf/bench.ts",
    "perf:hydration": "bun perf/hydration-check.ts",
    "intl:extract": "formatjs extract 'src/**/*.{ts,tsx}' --out-file src/locales/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]' --flatten",
    "intl:compile": "formatjs compile src/locales/en.json --out-file src/locales/compiled/en.json"
  },
